# ============================================
# ShuleHub SMS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
#   cp .env.example .env

# Neon PostgreSQL connection string.
# IMPORTANT: remove "&channel_binding=require" if Neon gives it to you.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Local development (sandbox / docker postgres)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
